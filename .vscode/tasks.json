{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "detekt",
      "type": "shell",
      "command": "./gradlew detekt --console=plain",
      "group": "test",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": [
        {
          "owner": "detekt",
          "source": "detekt",
          "fileLocation": "absolute",
          "severity": "error",
          "pattern": {
            "regexp": "^e: (.+?):(\\d+):(\\d+) (.+) \\[(\\w+)\\]$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4,
            "code": 5
          }
        },
        {
          "owner": "detekt",
          "source": "detekt",
          "fileLocation": "absolute",
          "severity": "warning",
          "pattern": {
            "regexp": "^w: (.+?):(\\d+):(\\d+) (.+) \\[(\\w+)\\]$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4,
            "code": 5
          }
        }
      ]
    }
  ]
}
